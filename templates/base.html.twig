<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
<div class="d-flex flex-column min-vh-100">
    <div {{ is_granted('IS_IMPERSONATOR') ? 'style="background-color: red !important"' }}>
        <header class="d-flex flex-column flex-sm-row align-items-center justify-content-between px-4 py-3 border-bottom border-subtle shadow">
            <a href="{{ path('app_homepage') }}">
                <img style="height: 42px;" src="{{ asset('images/starshop-logo.png') }}" alt="starshop logo">
            </a>

            <nav class="d-flex gap-3 fw-semibold">
                <a class="nav-link-app" href="{{ path('app_homepage') }}">Home</a>
                <a class="nav-link-app" href="{{ path('app_part_index') }}">Parts</a>

                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <div class="dropdown">
                        <button
                            class="dropdown-toggle btn"
                            type="button"
                            id="user-dropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            <img
                                src="{{ app.user.avatarUri }}"
                                alt="{{ app.user.displayName }} Avatar">
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="user-dropdown">
                            <li>
                                <a class="dropdown-item" href="{{ path('_logout_main') }}">Log Out</a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <a class="nav-link-app" href="{{ path('app_login') }}">Log In</a>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-link-app" href="{{ path('app_admin') }}">Admin</a>
                {% endif %}

                {% if is_granted('IS_IMPERSONATOR') %}
                    <a class="dropdown-item" href="{{ path('app_homepage', {'_switch_user': '_exit'}) }}">Exit Impersonation</a>
                {% endif %}
            </nav>
        </header>

        {% for flash in app.flashes('success') %}
            <div class="alert alert-success">{{ flash }}</div>
        {% endfor %}

        {% for flash in app.flashes('error') %}
            <div class="alert alert-danger">{{ flash }}</div>
        {% endfor %}

        {% block body %}{% endblock %}
    </div>

    <div class="app-footer mt-auto p-4 text-center">
        Made with ❤️ by <a style="color: #0086C4;" href="https://symfonycasts.com">SymfonyCasts</a>
    </div>
</div>
</body>
</html>
