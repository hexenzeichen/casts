<!DOCTYPE html>
<html class="dark">
<head>
    <script>
        (function(){var t=localStorage.getItem('theme')||'dark';if(t==='dark')document.documentElement.classList.add('dark');else document.documentElement.classList.remove('dark');})();
    </script>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
<div class="flex flex-col justify-between min-h-screen relative">
    <div  {{ is_granted('IS_IMPERSONATOR') ? 'style="background-color: red !important"' }}>
        <header class="h-[114px] shrink-0 flex flex-col sm:flex-row items-center sm:justify-between py-4 sm:py-0 px-6 border-b border-[var(--color-border)] shadow-md">
            <a href="{{ path('app_homepage') }}">
                <img class="h-[42px]" src="{{ asset('images/starshop-logo.png') }}" alt="starshop logo">
            </a>

            <nav class="flex space-x-4 font-semibold items-center">
                <button
                    data-controller="dark-mode"
                    data-action="click->dark-mode#toggle"
                    aria-label="Toggle dark/light mode"
                    class="relative flex h-7 w-14 items-center rounded-full p-1 transition-colors duration-300 bg-slate-300 dark:bg-slate-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
                >
                    <span class="absolute left-1 flex h-5 w-5 items-center justify-center rounded-full bg-white shadow transition-transform duration-300 dark:translate-x-7">
                        <svg class="h-3 w-3 text-amber-500 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.166 17.834a.75.75 0 0 0-1.06 1.06l1.59 1.591a.75.75 0 1 0 1.061-1.06l-1.59-1.591ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.166 6.106a.75.75 0 0 0 1.06 1.06l1.591-1.59a.75.75 0 1 0-1.06-1.061L6.166 6.106Z"/>
                        </svg>
                        <svg class="h-3 w-3 text-slate-800 hidden dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z" clip-rule="evenodd"/>
                        </svg>
                    </span>
                </button>

                <a class="hover:text-amber-400 pt-2" href="{{ path('app_homepage') }}">
                    Home
                </a>
                <a class="hover:text-amber-400  pt-2" href="{{ path('app_part_index') }}">
                    Parts
                </a>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <div class="dropdown">
                        <button
                            class="dropdown-toggle btn"
                            type="button"
                            id="user-dropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            <img
                                src="{{ app.user.avatarUri }}"
                                alt="{{ app.user.displayName }} Avatar">
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="user-dropdown">
                            <li>
                                <a class="dropdown-item" href="{{ path('_logout_main') }}">Log Out</a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <a class="hover:text-amber-400 pt-2" href="{{ path('app_login') }}">Log In</a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                        <a class="hover:text-amber-400 pt-2" href="{{ path('app_admin') }}">Admin</a>
                {% endif %}
                {% if is_granted('IS_IMPERSONATOR') %}
                    <a class="dropdown-item" href="{{ path('app_homepage', {
                        '_switch_user': '_exit'
                    }) }}">Exit Impersonation</a>
                {% endif %}
            </nav>
        </header>

        {% for flash in app.flashes('success') %}
            <div class="alert alert-success">{{ flash }}</div>
        {% endfor %}

        {% for flash in app.flashes('error') %}
            <div class="alert alert-danger">{{ flash }}</div>
        {% endfor %}

        {% block body %}{% endblock %}
    </div>
    <div class="p-5 bg-[var(--color-overlay)] mt-3 text-center">
        Made with ❤️ by <a class="text-[var(--color-link)]" href="https://symfonycasts.com">SymfonyCasts</a>
    </div>
</div>
</body>
</html>
